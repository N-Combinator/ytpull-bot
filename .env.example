# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Optional: base URL of a self-hosted Telegram Bot API server.
# Leave empty to use the public api.telegram.org (50 MB upload limit).
# Set it to raise the upload limit to 2 GB (requires running your own
# telegram-bot-api server, see README).
# Example: http://localhost:8081/bot
TELEGRAM_API_BASE=

# Optional: directory for temporary downloads (default: system temp)
DOWNLOAD_DIR=

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Default: INFO
LOG_LEVEL=INFO

# Optional: secret seed for the access-password gate. The password users must send
# is sha256("NickOl Family" + AUTH_SEED). Leave empty to disable the gate (open bot).
AUTH_SEED=

# Optional: path to a Netscape cookies.txt exported from a logged-in YouTube account.
# Needed when YouTube gates the server IP with a "confirm you're not a bot" check.
COOKIES_FILE=
